 bool platformHandleEvents(void) {
+    // A30 physical buttons are keyboard events on gpio-keys-polled (event3).
+    // The virtual SDL joystick on event4 does not carry them, so feed them to
+    // RunnerKeyboard directly, the same way Spruce emulators read this device.
+    if (a30KeyFd >= 0 && g_runner && g_runner->keyboard) {
+        struct input_event ev;
+        while (read(a30KeyFd, &ev, sizeof(ev)) == (ssize_t)sizeof(ev)) {
+            // Physical Menu/Esc: long press quits the game back to SpruceOS.
+            if (ev.type == EV_KEY && ev.code == 1) {
+                if (ev.value == 1) { escHeld = true; escDownAt = SDL_GetTicks(); }
+                else if (ev.value == 0) { escHeld = false; escDownAt = 0; }
+                continue;
+            }
+            int gml = 0;
+            if (ev.type == EV_KEY) {
+                switch (ev.code) {
+                    case 103: gml = VK_UP;    break;
+                    case 108: gml = VK_DOWN;  break;
+                    case 105: gml = VK_LEFT;  break;
+                    case 106: gml = VK_RIGHT; break;
+                    case 57:  gml = 90;       break; /* A -> Z (confirm) */
+                    case 29:  gml = 88;       break; /* B -> X (cancel) */
+                    case 42:  gml = 88;       break; /* X -> X (cancel) */
+                    case 56:  gml = 67;       break; /* Y -> C (game menu) */
+                    case 28:  gml = VK_ENTER; break; /* Start -> Enter */
+                    default: break;
+                }
+            }
+            if (!gml) continue;
+            if (ev.value == 1 || ev.value == 2)
+                RunnerKeyboard_simulatePress(g_runner->keyboard, gml);
+            else if (ev.value == 0)
+                RunnerKeyboard_simulateRelease(g_runner->keyboard, gml);
+        }
+    }
+    // Analog stick on MIYOO Pad1 (event4): axes 16/17 report -1/0/1.
+    // Feed transitions only, so holding a direction does not re-trigger it.
+    if (a30StickFd >= 0 && g_runner && g_runner->keyboard) {
+        struct input_event ev;
+        while (read(a30StickFd, &ev, sizeof(ev)) == (ssize_t)sizeof(ev)) {
+            if (ev.type != EV_ABS || (ev.code != 16 && ev.code != 17)) continue;
+            int *state = (ev.code == 16) ? &stickX : &stickY;
+            int prev = *state;
+            *state = ev.value;
+            if (prev == ev.value) continue;
+            int prevKey = 0, nextKey = 0;
+            if (ev.code == 16) {
+                prevKey = prev < 0 ? VK_LEFT : prev > 0 ? VK_RIGHT : 0;
+                nextKey = ev.value < 0 ? VK_LEFT : ev.value > 0 ? VK_RIGHT : 0;
+            } else {
+                prevKey = prev < 0 ? VK_UP : prev > 0 ? VK_DOWN : 0;
+                nextKey = ev.value < 0 ? VK_UP : ev.value > 0 ? VK_DOWN : 0;
+            }
+            if (prevKey && prevKey != nextKey) RunnerKeyboard_simulateRelease(g_runner->keyboard, prevKey);
+            if (nextKey && nextKey != prevKey) RunnerKeyboard_simulatePress(g_runner->keyboard, nextKey);
+        }
+    }
+    if (escHeld && escDownAt && SDL_GetTicks() - escDownAt >= 1000) {
+        SDL_Event quitEvent = {0};
+        quitEvent.type = SDL_QUIT;
+        SDL_PushEvent(&quitEvent);
+        escHeld = false;
+        escDownAt = 0;
+    }
+

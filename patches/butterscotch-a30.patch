+                if (down && !kbPrev[i]) RunnerKeyboard_simulatePress(g_runner->keyboard, keys[i]);
+                if (!down && kbPrev[i]) RunnerKeyboard_simulateRelease(g_runner->keyboard, keys[i]);
+                kbPrev[i] = down;
+            }
+        }
+    }
